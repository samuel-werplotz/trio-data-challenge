%% 01-topologia-atual.mmd — o que roda HOJE, no docker-compose deste repositório.
%% Contraparte de 02-arquitetura-aws.mmd, que mostra o destino em produção.
%% SLAs anotados nas setas são os MEDIDOS neste ambiente, não alvos de projeto.
flowchart LR
    subgraph fontes["Fontes de dados"]
        TS[("TimescaleDB<br/>transactions 10M<br/>hypertable 1d · 338 chunks")]
        LEG[("PostgreSQL legado<br/>partner_institutions<br/>institution_configs")]
    end

    subgraph pipelines["Pipelines"]
        SW["sync-worker<br/>micro-batch por watermark<br/>ciclo 10s · :8001/metrics"]
        RS["ref-sync<br/>batch 5 min<br/>:8002/metrics"]
    end

    subgraph analitico["Camada analítica"]
        CH[("ClickHouse<br/>transactions_raw<br/>ReplacingMergeTree")]
        MV["MVs AggregatingMergeTree<br/>daily_by_institution<br/>status_funnel"]
        DICT["dict_institutions<br/>Dictionary<br/>LIFETIME 240–360s"]
    end

    subgraph consumidores["Aplicações consumidoras"]
        API["API FastAPI :8000<br/>/ops/volume-now<br/>/institutions/-code-/health<br/>/fraud/duplicates"]
        GRAF["Grafana :3000<br/>dashboards operacionais"]
        HEX["Hex (SaaS)<br/>exploração ad-hoc<br/>dos Data Champions"]
        ROUTER["Serviço de roteamento<br/>decisão automatizada<br/>de Pix"]
    end

    subgraph observ["Observabilidade e backup"]
        PROM["Prometheus<br/>coleta :8001 :8002 :8000"]
        MINIO[("MinIO :9002<br/>pgBackRest + clickhouse-backup")]
    end

    TS -->|"SELECT incremental<br/>freshness < 30s"| SW
    SW -->|"INSERT batch<br/>≤ 50k linhas/ciclo"| CH
    LEG -->|"max updated_at + count<br/>detecção de mudança"| RS
    RS -->|"SYSTEM RELOAD DICTIONARY<br/>freshness ≤ 5 min"| DICT
    LEG -.->|"SOURCE POSTGRESQL<br/>recarga automática"| DICT

    CH --> MV
    MV -->|"leitura agregada<br/>p50 ~8ms"| API
    CH -->|"leitura raw<br/>p50 ~140ms"| API
    DICT -->|"dictGetOrDefault"| API

    MV --> GRAF
    CH --> HEX
    API -->|"success_rate + P95<br/>resposta < 50ms"| ROUTER

    SW -.->|métricas| PROM
    RS -.->|métricas| PROM
    API -.->|métricas| PROM
    TS -.->|WAL archive| MINIO
    CH -.->|backup| MINIO

    classDef fonte fill:#1f4e5f,stroke:#0d2b35,color:#fff
    classDef pipe fill:#7a4b1e,stroke:#3d2510,color:#fff
    classDef anal fill:#2d5016,stroke:#152a09,color:#fff
    classDef cons fill:#4a2d5e,stroke:#241730,color:#fff
    classDef obs fill:#5e2d2d,stroke:#301717,color:#fff

    class TS,LEG fonte
    class SW,RS pipe
    class CH,MV,DICT anal
    class API,GRAF,HEX,ROUTER cons
    class PROM,MINIO obs
